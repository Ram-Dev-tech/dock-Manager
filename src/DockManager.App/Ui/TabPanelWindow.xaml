<Window x:Class="DockManager.App.Ui.TabPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DockManager.App.Ui"
        xmlns:integ="clr-namespace:DockManager.Core.Integrations;assembly=DockManager.Core"
        Title=""
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        MouseEnter="OnPanelMouseEnter"
        MouseLeave="OnPanelMouseLeave">

    <Window.Resources>
        <ui:IconConverter x:Key="IconConverter" />
        <ui:StringToVisibilityConverter x:Key="StringToVisibility" />

        <DataTemplate x:Key="ContentItemTemplate" DataType="{x:Type integ:AppContentItem}">
            <Grid Background="Transparent"
                  Cursor="Hand"
                  Margin="0,1"
                  ToolTip="{Binding Subtitle}"
                  MouseLeftButtonUp="OnItemMouseLeftButtonUp"
                  MouseEnter="OnItemMouseEnter"
                  MouseLeave="OnItemMouseLeave">
                <Border x:Name="ItemHighlight" Background="Transparent" CornerRadius="8" />
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding IconKey, Converter={StaticResource IconConverter}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding Subtitle}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="ItemHighlight" Property="Background" Value="#26FFFFFF" />
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Panel"
            Width="280"
            Padding="8"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Color="#FF000000" Direction="270" Opacity="0.5" ShadowDepth="2" />
        </Border.Effect>

        <StackPanel Orientation="Vertical">
            <StackPanel Margin="4,2,4,6" Orientation="Horizontal">
                <Image x:Name="AppIcon"
                       Width="16"
                       Height="16"
                       Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="AppTitle"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border x:Name="PreviewBox"
                    Height="110"
                    Margin="2,0,2,6"
                    Background="#22000000"
                    ClipToBounds="True"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>

            <TextBlock x:Name="LoadingText"
                       Margin="6,0,0,6"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Loading…"
                       Visibility="Collapsed" />

            <ItemsControl x:Name="ItemsList" Focusable="False" ItemTemplate="{StaticResource ContentItemTemplate}" />
        </StackPanel>
    </Border>
</Window>
