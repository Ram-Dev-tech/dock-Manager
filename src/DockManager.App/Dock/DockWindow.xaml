<Window x:Class="DockManager.App.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DockManager.App.Ui"
        xmlns:vm="clr-namespace:DockManager.Core.Ui;assembly=DockManager.Core"
        Title="Dock Manager"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragOver="OnPanelDragOver"
        Drop="OnPanelDrop"
        MouseEnter="OnPanelMouseEnter"
        MouseLeave="OnPanelMouseLeave">

    <Window.Resources>
        <ui:IconConverter x:Key="IconConverter" />

        <!-- Fixed slot size keeps the rendered layout identical to DockMetrics.Compute;
             separators and group headers collapse to their own compact rows. -->
        <Style x:Key="SlotStyle" TargetType="{x:Type ContentPresenter}">
            <Setter Property="Width" Value="{DynamicResource ItemSize}" />
            <Setter Property="Height" Value="{DynamicResource ItemSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Separator">
                    <Setter Property="Height" Value="9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="GroupHeader">
                    <Setter Property="Height" Value="20" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="{DynamicResource ItemSize}" />
            <Setter Property="Height" Value="{DynamicResource ItemSize}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ItemCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource ItemActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:DockItemViewModel}">
            <Grid Background="Transparent"
                  AllowDrop="True"
                  ToolTip="{Binding Tooltip}"
                  ToolTipService.Placement="{DynamicResource TooltipPlacement}"
                  MouseLeftButtonDown="OnItemMouseLeftButtonDown"
                  MouseLeftButtonUp="OnItemMouseLeftButtonUp"
                  MouseMove="OnItemMouseMove"
                  MouseRightButtonUp="OnItemMouseRightButtonUp"
                  MouseEnter="OnItemMouseEnter"
                  MouseLeave="OnItemMouseLeave"
                  DragOver="OnItemDragOver"
                  Drop="OnItemDrop">
                <Border x:Name="Highlight"
                        Background="Transparent"
                        CornerRadius="{DynamicResource ItemCornerRadius}" />
                <Border x:Name="SelectionRing"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="{DynamicResource ItemCornerRadius}"
                        Visibility="Collapsed" />
                <Image x:Name="Icon"
                       Source="{Binding IconKey, Converter={StaticResource IconConverter}}"
                       Width="{DynamicResource IconSize}"
                       Height="{DynamicResource IconSize}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Rectangle x:Name="SeparatorLine"
                           Width="{DynamicResource SeparatorWidth}"
                           Height="{DynamicResource SeparatorThickness}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource TextSecondary}"
                           Opacity="0.5"
                           Visibility="Collapsed" />
                <TextBlock x:Name="GroupLabel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <Ellipse x:Name="RunningIndicator"
                         Width="{DynamicResource RunningIndicatorSize}"
                         Height="{DynamicResource RunningIndicatorSize}"
                         Margin="0,0,5,5"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Fill="{DynamicResource AccentBrush}"
                         Visibility="Collapsed" />
                <Border x:Name="MissingBadge"
                        Width="12"
                        Height="12"
                        Margin="0,4,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#E0B3261E"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="!" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="RunningIndicator" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource ItemActive}" />
                    <Setter TargetName="RunningIndicator" Property="Fill" Value="{DynamicResource TextPrimary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.3" />
                    <Setter TargetName="MissingBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Separator">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SeparatorLine" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="GroupHeader">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="GroupLabel" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Panel"
            Padding="{DynamicResource DockPadding}"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            MouseRightButtonUp="OnPanelMouseRightButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              Color="#FF000000"
                              Direction="270"
                              Opacity="0.5"
                              ShadowDepth="2" />
        </Border.Effect>

        <Grid>
            <StackPanel Orientation="Vertical">
                <!-- Light filter box; only shown once the dock holds enough items for it to help. -->
                <Border x:Name="SearchHost"
                        Margin="0,0,0,6"
                        Background="{DynamicResource ItemHover}"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <TextBox x:Name="SearchBox"
                             Padding="6,3"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource TextPrimary}"
                             FontSize="11"
                             Foreground="{DynamicResource TextPrimary}"
                             TextChanged="OnSearchTextChanged"
                             ToolTip="Filter dock items"
                             PreviewMouseLeftButtonDown="OnSearchPreviewMouseDown" />
                </Border>

                <!-- The dock never grows past the screen: overflow scrolls inside this area. -->
                <ScrollViewer x:Name="ItemsScroll"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel Orientation="Vertical">
                        <ItemsControl x:Name="ApplicationsList"
                                      Focusable="False"
                                      ItemContainerStyle="{StaticResource SlotStyle}"
                                      ItemTemplate="{StaticResource ItemTemplate}"
                                      ItemsSource="{Binding Applications}" />

                        <Rectangle x:Name="ApplicationsSeparator"
                                   Height="{DynamicResource SeparatorThickness}"
                                   Margin="{DynamicResource SeparatorMargin}"
                                   Width="{DynamicResource SeparatorWidth}"
                                   Fill="{DynamicResource TextSecondary}"
                                   Opacity="0.35" />

                        <ItemsControl x:Name="FilesList"
                                      Focusable="False"
                                      ItemContainerStyle="{StaticResource SlotStyle}"
                                      ItemTemplate="{StaticResource ItemTemplate}"
                                      ItemsSource="{Binding Files}" />
                    </StackPanel>
                </ScrollViewer>

                <Rectangle x:Name="FilesSeparator"
                           Height="{DynamicResource SeparatorThickness}"
                           Margin="{DynamicResource SeparatorMargin}"
                           Width="{DynamicResource SeparatorWidth}"
                           Fill="{DynamicResource TextSecondary}"
                           Opacity="0.35" />

                <StackPanel Orientation="Vertical">
                    <Button x:Name="AddButton"
                            Click="OnAddClicked"
                            Style="{StaticResource FooterButtonStyle}"
                            ToolTip="Add an application, file or folder">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource GlyphFontSize}"
                                   Text="&#xE710;" />
                    </Button>
                    <Button x:Name="SettingsButton"
                            Click="OnSettingsClicked"
                            Style="{StaticResource FooterButtonStyle}"
                            ToolTip="Dock settings">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="{DynamicResource GlyphFontSize}"
                                   Text="&#xE713;" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Insertion position while reordering; never intercepts the mouse. -->
            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <Rectangle x:Name="InsertionIndicator"
                           Height="2"
                           Fill="{DynamicResource AccentBrush}"
                           RadiusX="1"
                           RadiusY="1"
                           Visibility="Collapsed" />
            </Canvas>
        </Grid>
    </Border>
</Window>
